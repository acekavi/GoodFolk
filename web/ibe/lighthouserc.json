{
	"ci": {
		"collect": {
			"numberOfRuns": 3,
			"settings": {
				"formFactor": "mobile",
				"throttlingMethod": "simulate",
				"onlyCategories": ["performance"]
			}
		},
		"assert": {
			"assertions": {
				"largest-contentful-paint": [
					"error",
					{ "maxNumericValue": 1500, "aggregationMethod": "pessimistic" }
				]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
