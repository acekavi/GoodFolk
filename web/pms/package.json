{
	"name": "pms",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"api:schemas": "cd ../.. && cargo run -q -p core-api --bin export-schemas -- web/pms/src/lib/api",
		"codegen": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/openapi.d.ts && graphql-codegen",
		"test:e2e": "playwright test",
		"audit": "bun audit --ignore=GHSA-pfhg-q3qv-9q6r --ignore=GHSA-27mw-82g8-phjj --ignore=GHSA-pxg6-pf52-xh8x --ignore=GHSA-g3hv-75wg-m249 --ignore=GHSA-gcqx-w48m-w2h4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "8.0.0",
		"@graphql-codegen/client-preset": "7.0.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"graphql": "17.0.2",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@noble/hashes": "2.4.0",
		"@tanstack/svelte-query": "6.2.4",
		"openapi-fetch": "0.17.0"
	}
}
