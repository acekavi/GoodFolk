  "components": {
    "schemas": {
      "Bed": {
        "type": "object",
        "description": "Beds of one kind in a room type, e.g. `{ \"kind\": \"king\", \"count\": 1 }`.",
        "required": [
          "kind",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "BedRequest": {
        "type": "object",
        "required": [
          "kind",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "type": "string",
            "description": "e.g. `king`, `queen`, `twin`, `sofa bed`."
          }
        }
      },
      "CreatePropertyRequest": {
        "type": "object",
        "required": [
          "code",
          "name",
          "timezone",
          "base_currency"
        ],
        "properties": {
          "base_currency": {
            "type": "string",
            "description": "ISO 4217 code, e.g. `LKR`."
          },
          "code": {
            "type": "string",
            "description": "2 to 10 capital letters or digits, unique within the tenant."
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone, e.g. `Asia/Colombo`."
          }
        }
      },
      "CreateRoomRangeRequest": {
        "type": "object",
        "description": "Rooms `{prefix}{first}` to `{prefix}{last}`: `{\"first\": 101, \"last\": 120}` adds 101 to 120.",
        "required": [
          "room_type_id",
          "first",
          "last"
        ],
        "properties": {
          "first": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "floor": {
            "type": [
              "string",
              "null"
            ]
          },
          "last": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "prefix": {
            "type": "string"
          },
          "room_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "CreateRoomRequest": {
        "type": "object",
        "required": [
          "room_type_id",
          "number"
        ],
        "properties": {
          "floor": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "type": "string",
            "description": "Letters, digits and `-`, up to 10 characters, unique within the property."
          },
          "room_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "CreateRoomTypeRequest": {
        "type": "object",
        "required": [
          "code",
          "name",
          "base_occupancy",
          "max_adults",
          "max_children",
          "max_occupancy"
        ],
        "properties": {
          "amenities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "base_occupancy": {
            "type": "integer",
            "format": "int32"
          },
          "bed_config": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BedRequest"
            }
          },
          "code": {
            "type": "string",
            "description": "1 to 10 capital letters or digits, unique within the property. Cannot be changed later."
          },
          "max_adults": {
            "type": "integer",
            "format": "int32"
          },
          "max_children": {
            "type": "integer",
            "format": "int32"
          },
          "max_occupancy": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Grant": {
        "type": "object",
        "description": "A role held tenant-wide (`property_id: None`) or for one property.",
        "required": [
          "role"
        ],
        "properties": {
          "property_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "user_id",
          "email",
          "display_name",
          "tenants",
          "grants"
        ],
        "properties": {
          "current_tenant": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Grant"
            }
          },
          "tenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantSummary"
            }
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Property": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "timezone",
          "base_currency",
          "check_in_time",
          "check_out_time",
          "business_date",
          "version"
        ],
        "properties": {
          "base_currency": {
            "type": "string"
          },
          "business_date": {
            "type": "string",
            "format": "date",
            "description": "The property's current trading day. Set to its local today when created; moved only by night audit."
          },
          "check_in_time": {
            "type": "string",
            "description": "Local time guests may check in from, `HH:MM`."
          },
          "check_out_time": {
            "type": "string",
            "description": "Local time guests check out by, `HH:MM`."
          },
          "code": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ReorderRequest": {
        "type": "object",
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Every id of the collection, in the new display order."
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "manager",
          "front_desk",
          "housekeeping",
          "accountant"
        ]
      },
      "Room": {
        "type": "object",
        "required": [
          "id",
          "property_id",
          "room_type_id",
          "number",
          "active",
          "sort_order",
          "version"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "floor": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string"
          },
          "property_id": {
            "type": "string",
            "format": "uuid"
          },
          "room_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "section_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "sort_order": {
            "type": "integer",
            "format": "int32"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RoomType": {
        "type": "object",
        "required": [
          "id",
          "property_id",
          "code",
          "name",
          "base_occupancy",
          "max_adults",
          "max_children",
          "max_occupancy",
          "bed_config",
          "amenities",
          "sort_order",
          "active",
          "version"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "amenities": {
