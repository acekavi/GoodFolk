{
  "openapi": "3.1.0",
  "info": {
    "title": "GoodFolk PMS API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "1"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "crate::routes::auth"
        ],
        "summary": "After 5 failed attempts for one email within 15 minutes, further attempts for that email are answered\nwith 429 until the window passes, whether or not the account exists. A successful sign-in clears them.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {},
          "429": {}
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "crate::routes::auth"
        ],
        "operationId": "logout",
        "responses": {
          "204": {},
          "401": {}
        }
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "tags": [
          "crate::routes::auth"
        ],
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "409": {},
          "422": {}
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "crate::routes::auth"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {}
        }
      }
    },
    "/api/v1/properties": {
      "post": {
        "tags": [
          "crate::routes::properties"
        ],
        "operationId": "create",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePropertyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "403": {},
          "409": {},
          "422": {}
        }
      }
    },
    "/api/v1/properties/{property}": {
      "patch": {
        "tags": [
          "crate::routes::properties"
        ],
        "summary": "Changes a property's settings. The business date is not editable: night audit moves it.",
        "operationId": "update",
        "parameters": [
          {
            "name": "property",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "the version edited, e.g. \"3\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePropertyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Property"
                }
              }
            }
          },
          "403": {},
          "404": {},
          "412": {},
          "422": {},
          "428": {}
        }
      }
    },
    "/api/v1/session/tenant": {
      "put": {
        "tags": [
          "crate::routes::auth"
        ],
        "operationId": "switch_tenant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SwitchTenantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "403": {}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreatePropertyRequest": {
        "type": "object",
        "required": [
          "code",
          "name",
          "timezone",
          "base_currency"
        ],
        "properties": {
          "base_currency": {
            "type": "string",
            "description": "ISO 4217 code, e.g. `LKR`."
          },
          "code": {
            "type": "string",
            "description": "2 to 10 capital letters or digits, unique within the tenant."
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone, e.g. `Asia/Colombo`."
          }
        }
      },
      "Grant": {
        "type": "object",
        "description": "A role held tenant-wide (`property_id: None`) or for one property.",
        "required": [
          "role"
        ],
        "properties": {
          "property_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "user_id",
          "email",
          "display_name",
          "tenants",
          "grants"
        ],
        "properties": {
          "current_tenant": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Grant"
            }
          },
          "tenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantSummary"
            }
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Property": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "timezone",
          "base_currency",
          "check_in_time",
          "check_out_time",
          "business_date",
          "version"
        ],
        "properties": {
          "base_currency": {
            "type": "string"
          },
          "business_date": {
            "type": "string",
            "format": "date",
            "description": "The property's current trading day. Set to its local today when created; moved only by night audit."
          },
          "check_in_time": {
            "type": "string",
            "description": "Local time guests may check in from, `HH:MM`."
          },
          "check_out_time": {
            "type": "string",
            "description": "Local time guests check out by, `HH:MM`."
          },
          "code": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "manager",
          "front_desk",
          "housekeeping",
          "accountant"
        ]
      },
      "SignupRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "display_name",
          "tenant_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "tenant_name": {
            "type": "string"
          }
        }
      },
      "SwitchTenantRequest": {
        "type": "object",
        "required": [
          "tenant_id"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TenantSummary": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "UpdatePropertyRequest": {
        "type": "object",
        "properties": {
          "check_in_time": {
            "type": [
              "string",
              "null"
            ],
            "description": "`HH:MM` (24-hour), local time."
          },
          "check_out_time": {
            "type": [
              "string",
              "null"
            ],
            "description": "`HH:MM` (24-hour), local time."
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}